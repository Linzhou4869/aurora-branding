# Solar Monitor Configuration
# Copy to .env and customize for your deployment

# =============================================================================
# Thresholds (Primary Configuration)
# =============================================================================

# Flag if solar output falls below this value (kW)
LOW_OUTPUT_THRESHOLD=100.0

# Flag if irradiance falls below this value (W/m²)
LOW_IRRADIANCE_THRESHOLD=200.0

# =============================================================================
# System Parameters
# =============================================================================

# Solar farm peak capacity (kW)
SOLAR_CAPACITY_KW=500.0

# Fixed base load (kW)
BASE_LOAD_KW=150.0

# Battery State of Charge (0.0 - 1.0)
BATTERY_SOC=0.85

# Battery degradation rate per cycle (0.012 = 1.2%)
DEGRADATION_RATE=0.012

# Standard Test Conditions irradiance (W/m²)
STC_IRRADIANCE=1000.0

# =============================================================================
# Site Configuration
# =============================================================================

# Site coordinates
SITE_LATITUDE=57.7826
SITE_LONGITUDE=14.1618

# Forecast horizon (days)
FORECAST_DAYS=3

# =============================================================================
# File Paths
# =============================================================================

# Output status file (JSON)
STATUS_FILE=solar_status.json

# Log file
LOG_FILE=solar_monitor.log

# Lock file (for concurrent write protection)
LOCK_FILE=solar_monitor.lock

# =============================================================================
# API Configuration
# =============================================================================

# Open-Meteo API endpoint (default is fine)
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
